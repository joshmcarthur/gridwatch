---
import type { SiteDay } from "@gridwatch/publisher/site-contract";
import Layout from "../layouts/Layout.astro";
import { dailyPath } from "../lib/daily-page";
import { episodeHeadline } from "../lib/episode-copy";
import {
  latestMarketUpdate,
  marketConditionCards,
  recentDays,
} from "../lib/market-conditions";
import {
  eventHeadline,
  eventPath,
  recentEvents,
} from "../lib/event-page";
import {
  formatTradingDate,
  loadSiteDay,
  loadSiteIndex,
  recentEpisodes,
} from "../lib/site-data";

const index = loadSiteIndex();
const loaded = new Map<string, SiteDay>();
const loadDay = (date: string): SiteDay => {
  const cached = loaded.get(date);
  if (cached) return cached;
  const day = loadSiteDay(date, index);
  loaded.set(date, day);
  return day;
};
const update = latestMarketUpdate(index, loadDay);
const cards = marketConditionCards(index, loadDay);
const recent = recentDays(index, undefined, loadDay);
const week = recent.slice(0, 7);
const earlier = recent.slice(7);
const episodes = recentEpisodes(index, loadDay);
const events = recentEvents(index, loadDay);
---

<Layout
  title="Gridwatch NZ"
  description="Pages from the Electricity Authority's public wholesale market files: prices, generation, reserves, and regional differences, for days that have already finished."
>
  <section class="prose">
    <h1>New Zealand's electricity market, day by day</h1>
    <p>
      The Electricity Authority publishes the files for New Zealand's wholesale
      electricity market. Wholesale prices are what generators and retailers
      paid each other, not the rate on a household bill. The files are a slog
      if you don't already work in the industry, because they were written for
      the systems that run the market.
    </p>
    <p>
      This site reads those files after the day is over and makes a page for
      each finished day: what power stations made, what it sold for,
      and where prices pulled apart.
    </p>
  </section>

  <section class="card" aria-labelledby="latest-heading">
    <h2 id="latest-heading">Latest market update</h2>
    {
      update.href ? (
        <p>
          <a href={update.href}>{update.dateLabel}</a>
        </p>
      ) : (
        <p>{update.dateLabel}</p>
      )
    }
    <p>{update.summary}</p>
    {
      update.generationLag ? (
        <p>
          {update.generationLag.text}
          {update.generationLag.latest ? (
            <>
              {" "}
              Latest complete generation day:{" "}
              <a href={update.generationLag.latest.href}>
                {update.generationLag.latest.label}
              </a>
              .
            </>
          ) : null}
        </p>
      ) : null
    }
    {
      update.href ? (
        <p>
          <a href={update.href}>Open the {update.dateLabel} page</a>
        </p>
      ) : null
    }
  </section>

  <section class="conditions" aria-labelledby="conditions-heading">
    <div class="conditions-intro prose">
      <h2 id="conditions-heading">Market conditions</h2>
      <p>
        Each card is one number from the latest day with complete files for it. There
        is no single score for the day. A card ranks its number against earlier
        complete days on this site, up to a year back, not against a fixed
        threshold. Each card says how many days it compared with.
      </p>
    </div>
    <ul class="condition-grid">
      {
        cards.map((card) => (
          <li class="card condition">
            <h3>{card.title}</h3>
            <p class="figure">{card.figure}</p>
            {card.bandNote ? <p>{card.bandNote}</p> : null}
            <p class="when">
              {card.href ? (
                <a href={card.href}>{card.dateLabel}</a>
              ) : (
                card.dateLabel
              )}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="card" aria-labelledby="recent-days-heading">
    <h2 id="recent-days-heading">Recent days</h2>
    {
      recent.length === 0 ? (
        <p>No days on this site yet.</p>
      ) : (
        <>
          <ol class="days week">
            {week.map((day) => (
              <li>
                <a href={day.href}>{day.label}</a>
                {day.lead ? <span class="note">{day.lead}</span> : null}
                {day.complete ? null : <span class="note">Incomplete.</span>}
              </li>
            ))}
          </ol>
          {earlier.length > 0 ? (
            <details>
              <summary>Earlier days</summary>
              <ol class="days">
                {earlier.map((day) => (
                  <li>
                    <a href={day.href}>{day.label}</a>
                    {day.complete ? null : (
                      <span class="note">Incomplete.</span>
                    )}
                  </li>
                ))}
              </ol>
            </details>
          ) : null}
        </>
      )
    }
  </section>

  <section class="card" aria-labelledby="recent-events-heading">
    <h2 id="recent-events-heading">Recent events</h2>
    <p>
      Write-ups of unusual stretches. Each one is still Unreviewed.
    </p>
    {
      events.length === 0 ? (
        <p>No written-up events on the days this site holds yet.</p>
      ) : (
        <ol class="episodes">
          {events.map(({ date, event }) => (
            <li>
              <a href={eventPath(date, event.episode_id)}>
                {formatTradingDate(date)}: {eventHeadline(event)}
              </a>
            </li>
          ))}
        </ol>
      )
    }
  </section>

  <section class="card" aria-labelledby="recent-episodes-heading">
    <h2 id="recent-episodes-heading">Recently detected</h2>
    <p>
      Stretches of the day that looked unusual in the public files. Not a written-up public
      event yet.
    </p>
    {
      episodes.length === 0 ? (
        <p>No unusual stretches on the days this site holds yet.</p>
      ) : (
        <ol class="episodes">
          {episodes.map(({ date, episode }) => (
            <li>
              <a href={`${dailyPath(date)}#episode-${episode.episode_id}`}>
                {formatTradingDate(date)}: {episodeHeadline(episode, loadDay(date))}
              </a>
            </li>
          ))}
        </ol>
      )
    }
  </section>
</Layout>

<style>
  .prose {
    margin-bottom: var(--space-6);
  }

  .card {
    background: var(--color-card);
    border-radius: var(--radius-card);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
    max-width: var(--measure-prose);
  }

  .conditions {
    margin-bottom: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .conditions-intro {
    margin-bottom: 0;
    max-width: var(--measure-prose);
  }

  .condition-grid {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  .condition {
    margin-bottom: 0;
    min-width: 0;
    max-width: none;
  }

  .condition h3 {
    margin: 0;
    font-size: var(--text-heading);
  }

  .figure {
    font-size: var(--text-body);
    color: var(--color-ink);
  }

  .when {
    font-size: var(--text-label);
    font-variant-numeric: tabular-nums;
  }

  .days,
  .episodes {
    margin: 0;
    padding-left: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .note {
    color: var(--color-ink-muted);
    font-size: var(--text-label);
  }

  .days li .note {
    margin-left: var(--space-2);
  }

  @media (min-width: 40rem) {
    .condition-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

---
import type { SiteDay } from "@gridwatch/publisher/site-contract";
import AiWriteup from "../components/AiWriteup.astro";
import Layout from "../layouts/Layout.astro";
import { dailyPath, daySources, weekSources } from "../lib/daily-page";
import { episodeHeadline } from "@gridwatch/publisher/story/episode-copy.ts";
import { dayBeats } from "@gridwatch/publisher/story/day-beats.ts";
import {
  latestMarketUpdate,
  marketConditionCards,
  recentDays,
  shortDayLabel,
} from "../lib/market-conditions";
import { nodalMapView, PRICE_BANDS, renderMapSvg } from "../lib/nodal-map";
import {
  eventHeadline,
  eventPath,
  recentEvents,
} from "../lib/event-page";
import {
  formatTradingDate,
  loadSiteDay,
  loadSiteIndex,
  recentEpisodes,
} from "../lib/site-data";

const index = loadSiteIndex();
const loaded = new Map<string, SiteDay>();
const loadDay = (date: string): SiteDay => {
  const cached = loaded.get(date);
  if (cached) return cached;
  const day = loadSiteDay(date, index);
  loaded.set(date, day);
  return day;
};
const update = latestMarketUpdate(index, loadDay);
const cards = marketConditionCards(index, loadDay);
const recent = recentDays(index);
const week = recent.slice(0, 7);
const earlier = recent.slice(7);
const episodes = recentEpisodes(index, loadDay);
const events = recentEvents(index, loadDay);

// The latest day's story leads the page (ADR-0029), with a still map at its main moment.
const latestDay = update.date ? loadDay(update.date) : null;
const story = latestDay ? dayBeats(latestDay) : null;
const mapView = latestDay ? nodalMapView(latestDay) : null;
const otahuhu = mapView?.places.find(
  (place) => place.point_of_connection === "OTA2201",
);
const peak = story?.beats
  .filter((beat) => beat.rule === "price_peak")
  .sort(
    (a, b) =>
      (otahuhu?.prices[b.at - 1] ?? 0) - (otahuhu?.prices[a.at - 1] ?? 0),
  )[0];
const mapPeriod = peak?.at ?? mapView?.defaultPeriod ?? 1;
const mapClock =
  mapView?.periods.find((item) => item.period === mapPeriod)?.time ?? "";
const mapSvg = mapView
  ? renderMapSvg(mapView, mapPeriod, {
      id: "home-map",
      title: `Wholesale prices on the grid at ${mapClock}, ${update.dateLabel}`,
      summary: `Each dot is a named place on the grid, coloured by its wholesale price at ${mapClock}.`,
    })
  : null;
---

<Layout
  title="Gridwatch NZ"
  description="Pages from the Electricity Authority's public wholesale market files: prices, generation, reserves, and regional differences, for days that have already finished."
>
  <h1 class="site-title">New Zealand's electricity market, day by day</h1>

  <section class="card story" aria-labelledby="latest-heading">
    <p class="eyebrow">
      Latest day:{" "}
      {update.href ? <a href={update.href}>{update.dateLabel}</a> : update.dateLabel}
    </p>
    <h2 id="latest-heading">{story?.headline ?? "Latest market update"}</h2>
    <div class="story-body">
      <div class="story-text">
        {latestDay?.narrative ? (
          <AiWriteup
            text={latestDay.narrative.text}
            sources={daySources(latestDay.narrative)}
          />
        ) : (
          <p class="lede">{story?.lede ?? update.summary}</p>
        )}
        {update.generationLag ? (
          <p class="note">
            {update.generationLag.text}
            {update.generationLag.latest ? (
              <>
                {" "}
                Latest complete generation day:{" "}
                <a href={update.generationLag.latest.href}>
                  {update.generationLag.latest.label}
                </a>
                .
              </>
            ) : null}
          </p>
        ) : null}
        {update.href ? (
          <p>
            <a class="open" href={update.href}>
              See the whole day
            </a>
          </p>
        ) : null}
        {week.length > 0 ? (
          <div class="this-week">
            <h3 class="week-heading">This week</h3>
            {index.week ? (
              <AiWriteup text={index.week.text} sources={weekSources(index.week)} />
            ) : null}
            <ol class="days-inline" aria-label="Days this week">
              {week.map((day) => (
                <li>
                  <a href={day.href}>{shortDayLabel(day.date)}</a>
                  {day.complete ? null : (
                    <span class="incomplete" title="Some files for this day are missing">
                      *<span class="visually-hidden"> (incomplete)</span>
                    </span>
                  )}
                </li>
              ))}
            </ol>
            {week.some((day) => !day.complete) ? (
              <p class="note">* Some files for that day are missing.</p>
            ) : null}
          </div>
        ) : null}
      </div>
      {mapSvg ? (
        <figure class="still-map">
          <a href={update.href ? `${update.href}#map` : "#"} aria-hidden="true" tabindex="-1">
            <Fragment set:html={mapSvg} />
          </a>
          <figcaption>
            Wholesale prices on the grid at {mapClock}.{" "}
            {PRICE_BANDS.map((band, at) => (
              <span class="band">
                <span class="swatch" style={`background:${band.fill}`} />
                {band.label}
                {at < PRICE_BANDS.length - 1 ? " " : ""}
              </span>
            ))}
          </figcaption>
        </figure>
      ) : null}
    </div>
  </section>

  <section class="conditions" aria-labelledby="conditions-heading">
    <div class="conditions-intro prose">
      <h2 id="conditions-heading">Market conditions</h2>
      <details class="how">
        <summary>How these cards work</summary>
        <p>
          Each card is one number from the latest day with complete files for
          it. A card ranks its number
          against earlier complete days on this site, up to a year back, not
          against a fixed threshold.
        </p>
      </details>
    </div>
    <ul class="condition-grid">
      {
        cards.map((card) => (
          <li class="card condition">
            <h3>{card.title}</h3>
            <p class="figure">{card.figure}</p>
            {card.bandNote ? <p>{card.bandNote}</p> : null}
            <p class="when">
              {card.href ? (
                <a href={card.href}>{card.dateLabel}</a>
              ) : (
                card.dateLabel
              )}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  {
    earlier.length > 0 ? (
      <details class="card earlier">
        <summary>Earlier days</summary>
        <ol class="days">
          {earlier.map((day) => (
            <li>
              <a href={day.href}>{day.label}</a>
              {day.complete ? null : (
                <span class="incomplete" title="Some files for this day are missing">
                  *<span class="visually-hidden"> (incomplete)</span>
                </span>
              )}
            </li>
          ))}
        </ol>
      </details>
    ) : null
  }

  {
    events.length > 0 ? (
      <section class="card" aria-labelledby="recent-events-heading">
        <h2 id="recent-events-heading">Recent events</h2>
        <p>Write-ups of unusual stretches, written by AI.</p>
        <ol class="episodes">
          {events.map(({ date, event }) => (
            <li>
              <a href={eventPath(date, event.episode_id)}>
                {formatTradingDate(date)}: {eventHeadline(event, loadDay(date))}
              </a>
            </li>
          ))}
        </ol>
      </section>
    ) : null
  }

  <section class="card" aria-labelledby="recent-episodes-heading">
    <h2 id="recent-episodes-heading">Recently detected</h2>
    <p>
      Stretches of the day that looked unusual in the public files.
    </p>
    {
      episodes.length === 0 ? (
        <p>No unusual stretches on the days this site holds yet.</p>
      ) : (
        <ol class="episodes">
          {episodes.map(({ date, episode }) => (
            <li>
              <a href={`${dailyPath(date)}#episode-${episode.episode_id}`}>
                {formatTradingDate(date)}: {episodeHeadline(episode, loadDay(date))}
              </a>
            </li>
          ))}
        </ol>
      )
    }
  </section>
  <section class="prose about" aria-labelledby="about-heading">
    <h2 id="about-heading">About this site</h2>
    <p>
      The Electricity Authority publishes the files for New Zealand's wholesale
      electricity market. Wholesale prices are what generators and retailers
      paid each other, not the rate on a household bill. The files are a slog
      if you don't already work in the industry, because they were written for
      the systems that run the market.
    </p>
    <p>
      This site reads those files after the day is over and makes a page for
      each finished day: what power stations made, what it sold for, and where
      prices pulled apart. <a href="/about/">More about the market</a>.
    </p>
  </section>
</Layout>

<style>
  .site-title {
    font-size: var(--text-heading);
    margin: 0 0 var(--space-4);
    color: var(--color-ink-muted);
  }

  .story h2 {
    margin: 0;
    font-size: var(--text-title);
    line-height: 1.2;
  }

  .eyebrow {
    margin: 0;
    font-size: var(--text-label);
    font-weight: 700;
  }

  .story-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    align-items: start;
  }

  @media (min-width: 48rem) {
    .story-body {
      grid-template-columns: minmax(0, 1fr) minmax(12rem, 14rem);
    }
  }

  .story-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
  }

  .lede {
    margin: 0;
    font-size: var(--text-body);
  }

  .open {
    font-weight: 700;
  }

  .still-map {
    margin: 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .still-map :global(svg) {
    width: 100%;
    height: auto;
    aspect-ratio: 330 / 480;
    display: block;
    background: var(--color-page);
    border-radius: var(--radius-card);
  }

  .still-map :global(.place-name) {
    font-size: 10px;
    font-weight: 700;
    fill: var(--color-ink);
    paint-order: stroke;
    stroke: var(--color-page);
    stroke-width: 3px;
  }

  .still-map :global(.place-price) {
    font-size: 13px;
    font-weight: 700;
    fill: var(--color-ink);
    paint-order: stroke;
    stroke: var(--color-page);
    stroke-width: 3px;
  }

  .still-map :global(.map-note) {
    font-size: 9px;
    font-weight: 700;
    fill: var(--color-ink);
  }

  .still-map :global(.map-note.muted) {
    font-weight: 400;
    fill: var(--color-ink-muted);
  }

  .still-map figcaption {
    font-size: var(--text-label);
    color: var(--color-ink-muted);
  }

  .band {
    display: inline-block;
    white-space: nowrap;
    margin-right: var(--space-2);
  }

  .swatch {
    display: inline-block;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 3px;
    margin: 0 var(--space-1) 0 var(--space-2);
    vertical-align: -1px;
  }

  .how > summary {
    cursor: pointer;
    font-size: var(--text-label);
    font-weight: 700;
  }

  .earlier > summary {
    cursor: pointer;
    font-weight: 700;
  }

  .this-week {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-rule);
  }

  .week-heading {
    margin: 0;
    font-size: var(--text-body);
  }

  .days-inline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
  }

  .days-inline li + li::before {
    content: "·";
    margin-right: var(--space-2);
    color: var(--color-ink-muted);
  }

  .incomplete {
    color: var(--color-caution);
    font-weight: 700;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .about {
    max-width: var(--measure-prose);
  }

  .prose {
    margin-bottom: var(--space-6);
  }

  .card {
    background: var(--color-card);
    border-radius: var(--radius-card);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  /* Every card spans the page like the lead story; text inside keeps a reading width. */
  .card > p,
  .card > details,
  .episodes {
    max-width: var(--measure-prose);
  }

  .conditions {
    margin-bottom: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .conditions-intro {
    margin-bottom: 0;
    max-width: var(--measure-prose);
  }

  .condition-grid {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  .condition {
    margin-bottom: 0;
    min-width: 0;
  }

  .condition h3 {
    margin: 0;
    font-size: var(--text-heading);
  }

  .figure {
    font-size: var(--text-body);
    color: var(--color-ink);
  }

  .when {
    font-size: var(--text-label);
    font-variant-numeric: tabular-nums;
  }

  .days,
  .episodes {
    margin: 0;
    padding-left: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .note {
    color: var(--color-ink-muted);
    font-size: var(--text-label);
  }

  .days li .note {
    margin-left: var(--space-2);
  }

  @media (min-width: 40rem) {
    .condition-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

---
import Redirect from "../../../../layouts/Redirect.astro";
import {
  dailyStaticPaths,
  dateFromParams,
  mapPath,
} from "../../../../lib/daily-page";
import { formatTradingDate, loadSiteIndex } from "../../../../lib/site-data";

export function getStaticPaths() {
  return dailyStaticPaths(loadSiteIndex());
}

const { year, month, day } = Astro.params;
if (!year || !month || !day) throw new Error("Missing date params");
const date = dateFromParams(year, month, day);
---

<Redirect to={mapPath(date)} title={`The price map for ${formatTradingDate(date)}`} />

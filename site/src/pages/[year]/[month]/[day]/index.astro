---
import DayCompare from "../../../../components/DayCompare.astro";
import EnergySankeyChart from "../../../../components/EnergySankeyChart.astro";
import EventStory from "../../../../components/EventStory.astro";
import FuelPlants from "../../../../components/FuelPlants.astro";
import NodalPriceMap from "../../../../components/NodalPriceMap.astro";
import PriceChart from "../../../../components/PriceChart.astro";
import ReserveChart from "../../../../components/ReserveChart.astro";
import Layout from "../../../../layouts/Layout.astro";
import {
  dailyPath,
  dailyStaticPaths,
  dateFromParams,
  gapNote,
  monthGroups,
  neighbouringDays,
  totalsSentence,
} from "../../../../lib/daily-page";
import { dayBeats } from "../../../../lib/day-beats";
import {
  episodeEvidenceLinks,
  episodeHeadline,
} from "../../../../lib/episode-copy";
import { eventsOnDay } from "../../../../lib/event-page";
import { leadFact } from "../../../../lib/market-conditions";
import {
  formatTradingDate,
  loadSiteDay,
  loadSiteDayCached,
  loadSiteIndex,
} from "../../../../lib/site-data";

export function getStaticPaths() {
  return dailyStaticPaths(loadSiteIndex());
}

const { year, month, day: dayParam } = Astro.params;
if (!year || !month || !dayParam) throw new Error("Missing date params");
const date = dateFromParams(year, month, dayParam);
const index = loadSiteIndex();
const day = loadSiteDay(date, index);
const titleDate = formatTradingDate(date);
const loadEarlier = (earlier: string) => loadSiteDayCached(earlier, index);
const totals = totalsSentence(day);
const lead = leadFact(index, date, loadEarlier);
const story = dayBeats(day);
const gap = gapNote(day);
const neighbours = neighbouringDays(index, date);
const months = monthGroups(index);
const publishedEvents = eventsOnDay(day);
---

<Layout
  title={titleDate}
  description={`What happened on the New Zealand electricity system on ${titleDate}.`}
>
  <p class="home">
    <a href="/">Gridwatch NZ home</a>
  </p>

  <article class="prose">
    <header class="lede">
      <h1>{titleDate}</h1>
      {story.headline && <p class="headline">{story.headline}</p>}
      {story.lede ? <p>{story.lede}</p> : lead && <p>{lead}</p>}
    </header>

    <section class="slot" id="map" aria-label="Wholesale prices on the map">
      {gap && <p class="gap">{gap}</p>}
      {totals && <p class="totals">{totals}</p>}
      <NodalPriceMap day={day} story={story} />
    </section>

    {
      publishedEvents.length > 0 ? (
        <section class="slot" aria-labelledby="day-events">
          <h2 id="day-events">What happened</h2>
          {publishedEvents.map((event) => (
            <EventStory event={event} day={day} />
          ))}
        </section>
      ) : null
    }

    <details class="slot numbers" id="numbers">
      <summary>The numbers behind this</summary>

      {
        day.episodes && day.episodes.items.length > 0 ? (
          <section aria-labelledby="detected-episodes">
            <h3 id="detected-episodes">What stood out</h3>
            <p>
              Stretches of the day that looked unusual in the public files.
            </p>
            <ol class="episodes">
              {day.episodes.items.map((episode) => (
                <li id={`episode-${episode.episode_id}`}>
                  <p>{episodeHeadline(episode, day)}</p>
                  {episodeEvidenceLinks(episode).map((link) => (
                    <p>
                      <a href={link.href}>{link.label}</a>
                    </p>
                  ))}
                </li>
              ))}
            </ol>
          </section>
        ) : null
      }

      <section aria-labelledby="generation-mix">
        <h3 id="generation-mix">Generation through the day</h3>
        <DayCompare day={day} date={date} index={index} />
        <FuelPlants day={day} />
      </section>

      <section aria-labelledby="wholesale-prices">
        <h3 id="wholesale-prices">What it sold for</h3>
        <PriceChart day={day} />
      </section>

      <section aria-labelledby="reserve-prices">
        <h3 id="reserve-prices">What reserve cost</h3>
        <ReserveChart day={day} />
      </section>

      <section aria-labelledby="energy-flow">
        <h3 id="energy-flow">Where the energy went</h3>
        <EnergySankeyChart day={day} />
      </section>
    </details>

    <nav class="days" aria-label="Other days">
      <div class="turn">
        {
          neighbours.previous ? (
            <a href={dailyPath(neighbours.previous.date)}>
              Previous day: {formatTradingDate(neighbours.previous.date)}
            </a>
          ) : (
            <p>No earlier day on this site yet.</p>
          )
        }
        {
          neighbours.next ? (
            <a href={dailyPath(neighbours.next.date)}>
              Next day: {formatTradingDate(neighbours.next.date)}
            </a>
          ) : (
            <p>No later day on this site yet.</p>
          )
        }
      </div>

      <details class="archive">
        <summary>All days on this site</summary>
        {
          months.map((group) => (
            <section aria-labelledby={`month-${group.key}`}>
              <h2 id={`month-${group.key}`}>{group.label}</h2>
              <ol>
                {group.days.map((entry) => (
                  <li>
                    <a
                      href={dailyPath(entry.date)}
                      aria-current={entry.date === date ? "page" : undefined}
                    >
                      {formatTradingDate(entry.date)}
                    </a>
                  </li>
                ))}
              </ol>
            </section>
          ))
        }
      </details>
    </nav>

    <details class="words" id="words">
      <summary>Words on this page</summary>
      <dl>
        <div id="word-wholesale-price">
          <dt>Wholesale price</dt>
          <dd>
            What generators and retailers paid each other, not the rate on a
            household bill. More on{" "}
            <a href="/about/#wholesale">About</a>.
          </dd>
        </div>
        <div id="word-megawatt-hour">
          <dt>Megawatt-hour</dt>
          <dd>
            1,000 kilowatt-hours, the same kWh unit as a line on a power bill.
            More on{" "}
            <a href="/about/#wholesale">About</a>.
          </dd>
        </div>
        <div id="word-plant">
          <dt>Plant</dt>
          <dd>
            A power station: a dam, a wind farm, a geothermal field, or a
            thermal station.
          </dd>
        </div>
        <div id="word-places">
          <dt>The three places</dt>
          <dd>
            Ōtāhuhu (Auckland), Haywards (near Wellington) and Benmore (in the
            South Island) are the three places this page reports prices for.
            Two are in the North Island and one is in the South Island, and
            the two islands are joined by a cable. More on <a href="/about/#islands">About</a>.
          </dd>
        </div>
        <div id="word-reserve-price">
          <dt>Reserve price</dt>
          <dd>
            What the market paid to keep spare generating capacity ready in
            case a plant trips. Fast reserve acts within 6 seconds and slow
            reserve within 60 seconds.
          </dd>
        </div>
      </dl>
    </details>
  </article>
</Layout>

<script>
  // A link into "The numbers behind this" opens it first, so the target is visible.
  const openTarget = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    const target = id ? document.getElementById(id) : null;
    let parent = target?.parentElement ?? null;
    let opened = false;
    while (parent) {
      if (parent instanceof HTMLDetailsElement && !parent.open) {
        parent.open = true;
        opened = true;
      }
      parent = parent.parentElement;
    }
    if (opened) target?.scrollIntoView();
  };
  openTarget();
  addEventListener("hashchange", openTarget);
</script>

<style>
  article.prose {
    max-width: var(--measure-page);
  }

  .home {
    margin: 0 0 var(--space-5);
    font-size: var(--text-label);
  }

  .headline {
    margin: 0;
    font-size: var(--text-title);
    font-weight: 700;
    line-height: 1.2;
    max-width: 40rem;
  }

  .gap {
    margin: 0;
    font-size: var(--text-label);
    color: var(--color-ink-muted);
    border-left: 3px solid var(--color-caution);
    padding-left: var(--space-3);
  }

  .lede,
  .slot,
  .days,
  .words {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .slot,
  .days,
  .words {
    background: var(--color-card);
    border-radius: var(--radius-card);
    padding: var(--space-5);
  }

  .totals {
    margin: 0;
    max-width: 46rem;
  }

  .numbers > summary {
    cursor: pointer;
    font-size: var(--text-heading);
    font-weight: 700;
  }

  .numbers[open] {
    gap: var(--space-6);
  }

  .numbers section {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .numbers h3 {
    margin: 0;
    font-size: var(--text-heading);
  }

  .turn {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .archive {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .archive[open] {
    gap: var(--space-4);
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .episodes {
    flex-direction: column;
    flex-wrap: nowrap;
    list-style: decimal;
    padding-left: 1.5rem;
  }

  .words dl {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .words dt {
    font-size: var(--text-label);
    font-weight: 700;
  }

  .words dd {
    margin: 0.25rem 0 0;
  }

  a[aria-current="page"] {
    font-weight: 700;
    text-decoration: underline;
  }
</style>

---
import EnergySankeyChart from "../../../../components/EnergySankeyChart.astro";
import GenerationMixChart from "../../../../components/GenerationMixChart.astro";
import PriceChart from "../../../../components/PriceChart.astro";
import Layout from "../../../../layouts/Layout.astro";
import {
  completenessNotice,
  dailyPath,
  dailyStaticPaths,
  dateFromParams,
  headlineParagraphs,
  mapPath,
  monthGroups,
  neighbouringDays,
} from "../../../../lib/daily-page";
import { episodeHeadline } from "../../../../lib/episode-copy";
import {
  formatTradingDate,
  loadSiteDay,
  loadSiteIndex,
} from "../../../../lib/site-data";

export function getStaticPaths() {
  return dailyStaticPaths(loadSiteIndex());
}

const { year, month, day: dayParam } = Astro.params;
if (!year || !month || !dayParam) throw new Error("Missing date params");
const date = dateFromParams(year, month, dayParam);
const index = loadSiteIndex();
const day = loadSiteDay(date, index);
const titleDate = formatTradingDate(date);
const headlines = headlineParagraphs(day);
const notice = completenessNotice(day);
const neighbours = neighbouringDays(index, date);
const months = monthGroups(index);
---

<Layout
  title={`${titleDate} · Gridwatch NZ`}
  description={`What happened on the New Zealand electricity system on ${titleDate}.`}
>
  <p class="home">
    <a href="/">Gridwatch NZ home</a>
  </p>

  <article class="prose">
    <header class="lede">
      <h1>{titleDate}</h1>
      {headlines.map((paragraph) => <p>{paragraph}</p>)}
    </header>

    <section
      class:list={["notice", notice.tone]}
      aria-labelledby="completeness-heading"
    >
      <h2 id="completeness-heading">How complete is this day?</h2>
      {notice.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </section>

    <section class="slot" aria-labelledby="generation-mix">
      <h2 id="generation-mix">What made the power</h2>
      <GenerationMixChart day={day} />
    </section>

    <section class="slot" aria-labelledby="wholesale-prices">
      <h2 id="wholesale-prices">What it sold for</h2>
      <PriceChart day={day} />
      <p>
        <a href={mapPath(date)}>
          Map of wholesale prices at each named place on the grid
        </a>
      </p>
    </section>

    <section class="slot" aria-labelledby="energy-flow">
      <h2 id="energy-flow">Where the energy went</h2>
      <EnergySankeyChart day={day} />
    </section>

    <section class="slot" aria-labelledby="detected-episodes">
      <h2 id="detected-episodes">What stood out</h2>
      <p>
        Detectors look for unusual stretches in the public files and group the
        ones that overlap. Wholesale prices are what generators and retailers
        paid each other, not a household bill. Reserve prices are the cost of
        backup generation kept ready if something trips. These grouped
        readings are not yet a written-up public event.
      </p>
      {
        day.episodes === undefined || day.episodes.state === "missing" ? (
          <p>Grouped readings have not been published for this day yet.</p>
        ) : day.episodes.items.length === 0 ? (
          <p>No overlapping unusual stretches were grouped on this day.</p>
        ) : (
          <ol class="episodes">
            {day.episodes.items.map((episode) => (
              <li id={`episode-${episode.episode_id}`}>
                <p>{episodeHeadline(episode)}</p>
                <p>
                  Trading periods {episode.start_trading_period} to{" "}
                  {episode.end_trading_period}. {episode.member_count}{" "}
                  {episode.member_count === 1 ? "reading" : "readings"}.
                </p>
              </li>
            ))}
          </ol>
        )
      }
    </section>

    <nav class="days" aria-label="Other days">
      <div class="turn">
        {
          neighbours.previous ? (
            <a href={dailyPath(neighbours.previous.date)}>
              Previous day: {formatTradingDate(neighbours.previous.date)}
            </a>
          ) : (
            <p>No earlier day on this site yet.</p>
          )
        }
        {
          neighbours.next ? (
            <a href={dailyPath(neighbours.next.date)}>
              Next day: {formatTradingDate(neighbours.next.date)}
            </a>
          ) : (
            <p>No later day on this site yet.</p>
          )
        }
      </div>

      {
        months.map((group) => (
          <section aria-labelledby={`month-${group.key}`}>
            <h2 id={`month-${group.key}`}>{group.label}</h2>
            <ol>
              {group.days.map((entry) => (
                <li>
                  <a
                    href={dailyPath(entry.date)}
                    aria-current={entry.date === date ? "page" : undefined}
                  >
                    {formatTradingDate(entry.date)}
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </nav>
  </article>
</Layout>

<style>
  .home {
    margin: 0 0 var(--space-5);
    font-size: var(--text-label);
  }

  .lede,
  .notice,
  .slot,
  .days {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .notice,
  .slot,
  .days {
    background: var(--color-card);
    border-radius: var(--radius-card);
    padding: var(--space-5);
  }

  .notice.warn {
    outline: 2px solid var(--color-caution);
    outline-offset: -2px;
  }

  .turn {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .episodes {
    flex-direction: column;
    flex-wrap: nowrap;
    list-style: decimal;
    padding-left: 1.5rem;
  }

  a[aria-current="page"] {
    font-weight: 700;
    text-decoration: underline;
  }
</style>

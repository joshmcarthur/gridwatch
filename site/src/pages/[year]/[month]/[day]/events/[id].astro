---
import Redirect from "../../../../../layouts/Redirect.astro";
import { dateFromParams } from "../../../../../lib/daily-page";
import {
  eventHeadline,
  eventPath,
  eventPathsForIndex,
  findEvent,
} from "../../../../../lib/event-page";
import { loadSiteDay, loadSiteIndex } from "../../../../../lib/site-data";

export function getStaticPaths() {
  const index = loadSiteIndex();
  return eventPathsForIndex(index, (date) => loadSiteDay(date, index));
}

const { year, month, day: dayParam, id } = Astro.params;
if (!year || !month || !dayParam || !id) {
  throw new Error("Missing event params");
}
const date = dateFromParams(year, month, dayParam);
const day = loadSiteDay(date);
const event = findEvent(day, id);
---

<Redirect to={eventPath(date, id)} title={eventHeadline(event, day)} />

---
import Redirect from "../../layouts/Redirect.astro";
import { mapPath } from "../../lib/daily-page";
import { formatTradingDate, loadSiteIndex } from "../../lib/site-data";

const index = loadSiteIndex();
const date = index.latest_complete_sections.prices;
---

<Redirect
  to={date ? mapPath(date) : "/"}
  title={date
    ? `The price map for ${formatTradingDate(date)}`
    : "Gridwatch NZ home"}
/>

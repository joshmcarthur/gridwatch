---
import "@fontsource/dm-sans/400.css";
import "@fontsource/dm-sans/500.css";
import "@fontsource/dm-sans/700.css";
import { pageTitle } from "../lib/page-title";
import "../styles/tokens.css";
import "../styles/prose.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const documentTitle = pageTitle(title);
---

<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{documentTitle}</title>
  </head>
  <body>
    <header class="masthead">
      <svg
        class="contours"
        viewBox="0 0 1000 160"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path
          d="M0 120 C150 90 250 140 400 100 C550 60 650 110 800 70 C900 45 960 55 1000 40"
          fill="none"
          stroke="var(--color-contour)"
          stroke-opacity="0.35"
          stroke-width="2"></path>
        <path
          d="M0 140 C150 110 250 160 400 120 C550 80 650 130 800 90 C900 65 960 75 1000 60"
          fill="none"
          stroke="var(--color-contour)"
          stroke-opacity="0.25"
          stroke-width="2"></path>
        <path
          d="M0 100 C150 70 250 120 400 80 C550 40 650 90 800 50 C900 25 960 35 1000 20"
          fill="none"
          stroke="var(--color-contour)"
          stroke-opacity="0.2"
          stroke-width="2"></path>
      </svg>
      <a class="brand" href="/">
        <svg
          width="56"
          height="56"
          viewBox="0 0 56 56"
          aria-hidden="true"
        >
          <rect x="0" y="0" width="56" height="56" rx="14" fill="currentColor"
          ></rect>
          <path
            d="M8 38 C16 30 22 34 28 26 C34 18 42 22 48 14"
            fill="none"
            stroke="var(--color-contour)"
            stroke-width="3"
            stroke-linecap="round"></path>
          <path
            d="M8 46 C16 38 22 42 28 34 C34 26 42 30 48 22"
            fill="none"
            stroke="var(--color-fuel-solar)"
            stroke-width="3"
            stroke-linecap="round"></path>
          <path
            d="M8 30 C16 22 22 26 28 18 C34 10 42 14 48 8"
            fill="none"
            stroke="#fff"
            stroke-opacity="0.55"
            stroke-width="3"
            stroke-linecap="round"></path>
        </svg>
        <span class="wordmark">Gridwatch <span>NZ</span></span>
      </a>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <nav class="footer-nav" aria-label="Site">
        <a href="/about/">About</a>
        <a href="/how/">How we do this</a>
        <a href="/explainers/">Explainers</a>
        <a href="/terms/">Terms</a>
      </nav>
    </footer>
  </body>
</html>

<style>
  .masthead {
    position: relative;
    background: var(--color-ink);
    color: var(--color-card);
    padding: var(--space-6) var(--space-5);
  }

  .contours {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .brand {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    max-width: var(--measure-page);
    margin: 0 auto;
    color: inherit;
    text-decoration: none;
  }

  .brand:hover {
    text-decoration: none;
  }

  .brand svg {
    flex: none;
    color: var(--color-ink);
  }

  .wordmark {
    margin: 0;
    font-weight: 700;
    font-size: var(--text-title);
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .wordmark span {
    color: var(--color-contour);
  }

  main {
    max-width: var(--measure-page);
    margin: 0 auto;
    padding: var(--space-7) var(--space-5);
  }

  footer {
    max-width: var(--measure-page);
    margin: 0 auto;
    padding: 0 var(--space-5) var(--space-6);
  }

  .footer-nav {
    border-top: 1px solid var(--color-rule);
    padding-top: var(--space-4);
    font-size: var(--text-caption);
    line-height: 1.4;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-4);
  }
</style>

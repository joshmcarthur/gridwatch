---
import type { SiteDay, SiteIndex } from "@gridwatch/publisher/site-contract";
import GenerationMixChart from "./GenerationMixChart.astro";
import {
  dailyPath,
  defaultMixCompareDay,
  mixCompareDays,
} from "../lib/daily-page";
import { generationMix } from "../lib/generation-mix";
import { formatTradingDate } from "../lib/site-data";

interface Props {
  day: SiteDay;
  date: string;
  index: SiteIndex;
}

const { day, date, index } = Astro.props;
const thisMix = generationMix(day);
const options = mixCompareDays(index, date);
const other = defaultMixCompareDay(index, date);
const showCompare = thisMix !== null && other !== null && options.length > 0;
---

{
  showCompare && other ? (
    <div class="compare" data-compare-root>
      <div class="pair">
        <div data-compare-this>
          <h3 class="this-heading">{formatTradingDate(date)}</h3>
          <div class="chart-body">
            <GenerationMixChart day={day} />
          </div>
          <button type="button" class="compare-open" data-compare-open hidden>
            Compare with another day
          </button>
        </div>
        <div data-day-compare hidden>
          <form>
            <label for="compare-day">Compare with</label>
            <select id="compare-day">
              {
                options.map((entry) => (
                  <option
                    value={entry.date}
                    selected={entry.date === other.date}
                  >
                    {formatTradingDate(entry.date)}
                  </option>
                ))
              }
            </select>
          </form>
          <h3 id="compare-heading">{formatTradingDate(other.date)}</h3>
          <p id="compare-summary" aria-live="polite"></p>
          <div class="chart-body" data-compare-other></div>
        </div>
      </div>
      <noscript>
        <p>
          This page shows {formatTradingDate(date)}. Open{" "}
          <a href={dailyPath(other.date)}>{formatTradingDate(other.date)}</a> for
          that day's mix.
        </p>
      </noscript>
    </div>
  ) : (
    <GenerationMixChart day={day} />
  )
}

<script>
  import { bindDayCompare } from "../lib/day-compare-client";
  bindDayCompare();
</script>

<style>
  .compare-open {
    align-self: flex-start;
    font: inherit;
    font-size: var(--text-label);
    border: 1px solid var(--color-rule);
    background: var(--color-card);
    border-radius: 999px;
    padding: var(--space-1) var(--space-4);
    cursor: pointer;
  }

  .compare[data-paired] .compare-open {
    display: none;
  }

  /* One chart until the reader asks to compare: keep it the width it has when paired. */
  .compare:not([data-paired]) [data-compare-this] {
    max-width: 34rem;
  }

  .compare,
  .pair,
  [data-day-compare],
  [data-compare-this],
  [data-compare-other],
  .chart-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  [data-compare-this] .this-heading {
    display: none;
  }

  .compare[data-paired] [data-compare-this] .this-heading {
    display: block;
  }

  @media (min-width: 50rem) {
    .compare[data-paired] .pair {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto auto auto auto;
      column-gap: var(--space-5);
      row-gap: var(--space-4);
    }

    .compare[data-paired] [data-compare-this],
    .compare[data-paired] [data-day-compare] {
      display: grid;
      grid-template-rows: subgrid;
      grid-row: 1 / span 4;
      min-width: 0;
    }

    .compare[data-paired] [data-compare-this] {
      grid-column: 1;
    }

    .compare[data-paired] [data-day-compare] {
      grid-column: 2;
    }

    .compare[data-paired] [data-day-compare] form {
      grid-row: 1;
    }

    .compare[data-paired] [data-compare-this] .this-heading,
    .compare[data-paired] [data-day-compare] h3 {
      grid-row: 2;
    }

    .compare[data-paired] #compare-summary {
      grid-row: 3;
    }

    .compare[data-paired] .chart-body {
      grid-row: 4;
    }
  }

  .compare [data-day-compare][hidden] {
    display: none;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  select {
    font: inherit;
    max-width: 24rem;
  }

  h3 {
    margin: 0;
    font-size: var(--text-heading);
  }

  #compare-summary {
    margin: 0;
    font-size: var(--text-label);
    color: var(--color-ink-muted);
  }

  .compare .pair :global(svg) {
    width: 100%;
    max-width: 100%;
    height: auto;
    display: block;
  }
</style>

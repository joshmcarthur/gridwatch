---
import type { SiteDay } from "@gridwatch/publisher/site-contract";
import type { DayStory } from "../lib/day-beats";
import DayLane from "./DayLane.astro";
import {
  clientPayload,
  conditionalLanes,
  coverageSentence,
  dayLanes,
  formatPrice,
  laneAxis,
  nodalMapView,
  PRICE_BANDS,
  periodSummary,
  renderMapSvg,
  rowsForPeriod,
} from "../lib/nodal-map";

interface Props {
  day: SiteDay;
  story: DayStory;
}

const { day, story } = Astro.props;
const view = nodalMapView(day);
const beats = story.beats;

// Open on the day's highest price peak, else the half-hour with the widest spread.
const otahuhu = view?.places.find(
  (place) => place.point_of_connection === "OTA2201",
);
const peak = beats
  .filter((beat) => beat.rule === "price_peak")
  .sort(
    (a, b) =>
      (otahuhu?.prices[b.at - 1] ?? 0) - (otahuhu?.prices[a.at - 1] ?? 0),
  )[0];
const period = peak?.at ?? view?.defaultPeriod ?? 1;
const lanes = view ? dayLanes(day, view, beats) : [];
const wideLanes = view ? conditionalLanes(day, view) : [];
const axis = laneAxis(day);
const payload = view
  ? {
      ...clientPayload(
        view,
        beats.map(({ at, from, to, fuels }) => ({ at, from, to, fuels })),
      ),
      defaultPeriod: period,
      lanes: [...lanes, ...wideLanes],
    }
  : null;
const rows = payload ? rowsForPeriod(payload, period) : [];
const svg = view
  ? renderMapSvg(view, period, {
      id: "nodal-map-chart",
      title: "Wholesale prices at named places on the New Zealand grid",
      summary: periodSummary(view, period),
    })
  : null;
const clock =
  view?.periods.find((item) => item.period === period)?.time ?? "";
const allDay = (beat: (typeof beats)[number]) =>
  beat.from === 1 && beat.to === day.periods.length;
const activeIndex = beats.findIndex(
  (beat) => !allDay(beat) && period >= beat.from && period <= beat.to,
);
const litFuels: string[] | null =
  activeIndex >= 0 && (beats[activeIndex]?.fuels.length ?? 0) > 0
    ? (beats[activeIndex]?.fuels ?? null)
    : null;
const dim = (fuel: string) => litFuels !== null && !litFuels.includes(fuel);
const megawatts = new Intl.NumberFormat("en-NZ", { maximumFractionDigits: 0 });
const islandsNow = (view?.islands ?? []).map((island) => {
  const values = island.fuels.map((fuel) => fuel.megawatts[period - 1] ?? null);
  const total = values.reduce<number>((sum, value) => sum + (value ?? 0), 0);
  return {
    key: island.key,
    name: island.key === "north" ? "North Island" : "South Island",
    total,
    known: values.some((value) => value !== null),
    fuels: island.fuels.map((fuel, index) => ({
      ...fuel,
      now: values[index] ?? null,
    })),
  };
});
---

{
  view === null || svg === null ? (
    <p>
      A map of wholesale prices at each named place on the grid has not been
      published for this day yet.
    </p>
  ) : (
    <div class="story-map" data-nodal-map>
      <div class="layout">
        <figure class="map">
          <Fragment set:html={svg} />
          <figcaption>
            <ul class="bands" aria-label="Colour key, wholesale price">
              {PRICE_BANDS.map((band) => (
                <li>
                  <span class="swatch" style={`background:${band.fill}`} />
                  {band.label}, {band.range} per kWh
                </li>
              ))}
            </ul>
          </figcaption>
        </figure>

        <div class="side">
          <div class="control">
            <label for="nodal-period">Time of day</label>
            <p id="nodal-period-label" class="clock">{clock}</p>
            <input
              id="nodal-period"
              type="range"
              min="1"
              max={view.periods.length}
              value={period}
              step="1"
              aria-valuetext={clock}
            />
            <button type="button" id="nodal-play" aria-pressed="false">
              Play the day
            </button>
          </div>
          <p id="nodal-map-live-summary" class="summary" aria-live="polite">
            {periodSummary(view, period)}
          </p>

          <ol class="beats" aria-label="Moments in the day">
            {beats.map((beat, index) => (
              <li
                data-beat={index}
                class:list={[{ active: index === activeIndex }]}
              >
                <button
                  type="button"
                  aria-pressed={index === activeIndex ? "true" : "false"}
                >
                  <span class="beat-title">{beat.title}</span>
                  <span class="beat-when">{beat.when}</span>
                </button>
                <p>
                  {beat.text}
                  {beat.link && (
                    <>
                      {" "}
                      <a href={beat.link.href}>{beat.link.label}</a>.
                    </>
                  )}
                </p>
                {beat.flags.length > 0 && (
                  <ul class="flags" aria-label="Flagged as unusual">
                    {beat.flags.map((flag) => (
                      <li>{flag}</li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ol>

          {islandsNow.length > 0 ? (
            <div class="islands">
              {islandsNow.map((island) => (
                <section
                  data-island={island.key}
                  aria-labelledby={`island-${island.key}`}
                >
                  <h3 id={`island-${island.key}`}>
                    {island.name}{" "}
                    <span data-island-total>
                      {island.known
                        ? `${megawatts.format(island.total)} MW generating`
                        : "No numbers for this half-hour"}
                    </span>
                  </h3>
                  <div class="bar" aria-hidden="true">
                    {island.fuels.map((fuel) => (
                      <span
                        data-segment={fuel.fuel}
                        class:list={[{ dim: dim(fuel.fuel) }]}
                        style={`background:${fuel.colour};flex-basis:${island.total > 0 && fuel.now !== null ? ((fuel.now / island.total) * 100).toFixed(2) : 0}%`}
                      />
                    ))}
                  </div>
                  <ul>
                    {island.fuels.map((fuel) => (
                      <li
                        data-fuel={fuel.fuel}
                        class:list={[{ dim: dim(fuel.fuel) }]}
                        hidden={fuel.now === null || fuel.now < 1}
                      >
                        <span
                          class="swatch"
                          style={`background:${fuel.colour}`}
                        />
                        {fuel.label}{" "}
                        <span data-fuel-mw>
                          {fuel.now === null
                            ? ""
                            : `${megawatts.format(fuel.now)} MW`}
                        </span>
                      </li>
                    ))}
                  </ul>
                </section>
              ))}
            </div>
          ) : (
            <p class="summary">
              Generation numbers for this day are not in yet, so the map shows
              prices only.
            </p>
          )}

          <div class="lanes">
            {lanes.map((lane, index) => (
              <DayLane
                lane={lane}
                beats={beats}
                period={period}
                axis={index === lanes.length - 1 ? axis : null}
                lit={litFuels}
              />
            ))}
          </div>
        </div>
      </div>

      {wideLanes.length > 0 && (
        <section class="through" aria-labelledby="through-the-day">
          <h3 id="through-the-day">Through the day</h3>
          {wideLanes.map((lane) => (
            <DayLane
              lane={lane}
              beats={beats}
              period={period}
              axis={axis}
              lit={null}
              wide
            />
          ))}
        </section>
      )}

      <details class="more">
        <summary>How to read this</summary>
        <p>{coverageSentence(view)}</p>
        <p>
          Each dot is a named place on the grid, coloured by its wholesale price
          in the half-hour on the slider. The colours don't shift through the
          day, so orange at 3am means the same price as orange at 6pm, and the
          bigger dots are the cheapest or most expensive 5 percent of places in
          that half-hour.
        </p>
        <p>
          Ōtāhuhu, Haywards and Benmore carry price labels, and the price lane
          beside the map follows the same three places. Above 40c per kWh the
          lane squeezes its scale, so a spike keeps its shape, and the labels
          give the true values. The generation lane stacks every fuel for both
          islands. The cable arrow shows the day's average flow across Cook
          Strait. The flow in each half-hour isn't on this page yet.
        </p>
        <p>
          The moments beside the map come from fixed rules run over the day's
          numbers (the highest and lowest prices, when wind or solar peaked,
          lasting shifts in geothermal output, unusual stretches, and the
          cable).
        </p>
        <p>
          Source: Electricity Authority wholesale prices at each named place on
          the grid. Coordinates come from
          the Authority's public list of where local networks meet the grid.
          Contains data sourced from the LINZ Data Service licensed for reuse
          under CC BY 4.0. LINZ is Land Information New Zealand. CC BY 4.0 is
          Creative Commons Attribution 4.0. Coastline simplified; Chatham and
          subantarctic islands are not drawn.
        </p>
      </details>

      <details class="more">
        <summary>Show the numbers as a table</summary>
        <div class="table-wrap">
          <table id="nodal-map-table">
            <caption>
              Wholesale price at each named place for the selected half-hour,
              in dollars per megawatt-hour. Places without coordinates have a
              blank location.
            </caption>
            <thead>
              <tr>
                <th scope="col">
                  <button type="button" data-sort="point_of_connection">
                    Place
                  </button>
                </th>
                <th scope="col">
                  <button type="button" data-sort="location">Location</button>
                </th>
                <th scope="col">
                  <button type="button" data-sort="island">Island</button>
                </th>
                <th scope="col">
                  <button type="button" data-sort="price">
                    Price ($/MWh)
                  </button>
                </th>
                <th scope="col">
                  <button type="button" data-sort="outlier">Note</button>
                </th>
              </tr>
            </thead>
            <tbody>
              {rows.map((row) => (
                <tr>
                  <th scope="row">{row.point_of_connection}</th>
                  <td>{row.location}</td>
                  <td>{row.island}</td>
                  <td>{formatPrice(row.price)}</td>
                  <td>
                    {[
                      row.outlier ? "Large difference" : "",
                      row.proxy ? "Copied from a nearby place" : "",
                    ]
                      .filter(Boolean)
                      .join(". ")}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
      {payload && (
        <script
          is:inline
          type="application/json"
          id="nodal-map-payload"
          set:html={JSON.stringify(payload)}
        />
      )}
    </div>
  )
}

<script>
  import { bindNodalMap } from "../lib/nodal-map-client";
  bindNodalMap();
</script>

<style>
  .story-map {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    align-items: start;
  }

  @media (min-width: 48rem) {
    .layout {
      grid-template-columns: minmax(16rem, 28.5rem) 1fr;
    }
  }

  .map {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .map :global(svg) {
    width: 100%;
    height: auto;
    aspect-ratio: 330 / 480;
    display: block;
    background: var(--color-page);
    border-radius: var(--radius-card);
  }

  .map :global(.place-name) {
    font-size: 10px;
    font-weight: 700;
    fill: var(--color-ink);
    paint-order: stroke;
    stroke: var(--color-page);
    stroke-width: 3px;
  }

  .map :global(.place-price) {
    font-size: 13px;
    font-weight: 700;
    fill: var(--color-ink);
    paint-order: stroke;
    stroke: var(--color-page);
    stroke-width: 3px;
  }

  .map :global(.map-note) {
    font-size: 9px;
    font-weight: 700;
    fill: var(--color-ink);
  }

  .map :global(.map-note.muted) {
    font-weight: 400;
    fill: var(--color-ink-muted);
  }

  .bands,
  .islands ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    font-size: var(--text-label);
    color: var(--color-ink-muted);
  }

  .swatch {
    display: inline-block;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 3px;
    margin-right: var(--space-1);
    vertical-align: -1px;
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
  }

  .control {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .control label {
    font-size: var(--text-label);
    font-weight: 700;
  }

  .clock {
    margin: 0;
    font-size: var(--text-title);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }

  /* As wide as the lanes' plot (320 of 360 units), so the thumb lines up with the cursors. */
  input[type="range"] {
    width: calc(100% * 320 / 360);
    margin: 0;
    accent-color: var(--color-brand);
  }

  /* On a phone the lanes come straight after the slider, before the moments. */
  @media (max-width: 47.99rem) {
    .control {
      order: 1;
    }
    .summary {
      order: 2;
    }
    .lanes {
      order: 3;
    }
    .beats {
      order: 4;
    }
    .islands {
      order: 5;
    }
  }

  .through {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .through h3 {
    margin: 0;
    font-size: var(--text-heading);
  }

  .islands li.dim,
  .bar span.dim {
    opacity: 0.35;
  }

  .lanes {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }


  #nodal-play {
    align-self: flex-start;
    font: inherit;
    font-size: var(--text-label);
    border: 1px solid var(--color-rule);
    background: var(--color-card);
    border-radius: 999px;
    padding: var(--space-1) var(--space-4);
    cursor: pointer;
  }

  .summary {
    margin: 0;
    font-size: var(--text-label);
    color: var(--color-ink-muted);
  }

  .beats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .beats li {
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-chip);
    padding: var(--space-2) var(--space-3);
  }

  .beats li.active {
    border-color: var(--color-brand);
    box-shadow: inset 4px 0 0 var(--color-brand);
  }

  .beats button {
    all: unset;
    cursor: pointer;
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
    align-items: baseline;
    width: 100%;
  }

  .beats button:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 2px;
  }

  .beat-title {
    font-weight: 700;
  }

  .beat-when {
    font-size: var(--text-label);
    color: var(--color-ink-muted);
  }

  .beats p {
    margin: var(--space-2) 0 0;
  }

  /* With the script running, only the active moment shows its sentence. */
  [data-js] .beats li:not(.active) p,
  [data-js] .beats li:not(.active) .flags {
    display: none;
  }

  .flags {
    margin: var(--space-2) 0 0;
    padding-left: 1.25rem;
    font-size: var(--text-label);
    color: var(--color-ink-muted);
  }

  .islands {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-4);
  }

  .islands section {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .islands h3 {
    margin: 0;
    font-size: var(--text-body);
  }

  .islands h3 span {
    font-weight: 400;
    color: var(--color-ink-muted);
    font-size: var(--text-label);
  }

  .bar {
    display: flex;
    height: 0.9rem;
    border-radius: 4px;
    overflow: hidden;
    background: var(--color-page);
  }

  .bar span {
    flex-grow: 0;
    flex-shrink: 0;
    transition: flex-basis 0.2s;
  }

  @media (prefers-reduced-motion: reduce) {
    .bar span {
      transition: none;
    }
  }

  .more {
    font-size: var(--text-label);
  }

  .more > summary {
    cursor: pointer;
    font-weight: 700;
  }

  .more p {
    max-width: 46rem;
  }

  .table-wrap {
    overflow-x: auto;
  }

  table {
    border-collapse: collapse;
    width: 100%;
    min-width: 28rem;
  }

  caption {
    text-align: left;
    caption-side: top;
    margin-bottom: var(--space-2);
    color: var(--color-ink-muted);
  }

  th,
  td {
    padding: var(--space-1) var(--space-2);
    border-bottom: 1px solid var(--color-rule);
    text-align: left;
  }

  thead th {
    font-weight: 700;
  }

  tbody th {
    font-weight: 400;
  }

  thead button {
    font: inherit;
    font-weight: 700;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
  }
</style>

---
import type { SiteDay } from "@gridwatch/publisher/site-contract";
import ChartFigure from "./ChartFigure.astro";
import {
  BATTERY_COLOUR,
  FUEL_COLOUR,
  mixBatterySvg,
  mixStackSvg,
} from "../lib/generation-mix-chart";
import {
  generationMix,
  generationMixBatterySummary,
  generationMixSourceNote,
  generationMixSummary,
  generationMixTable,
} from "../lib/generation-mix";

interface Props {
  day: SiteDay;
}

const { day } = Astro.props;
const mix = generationMix(day);
const BATTERY_LABEL = "Battery (stored power)";
const svg = mix
  ? mixStackSvg(mix, {
      id: "generation-mix-chart",
      title: "Generation mix by fuel",
      summary: generationMixSummary(mix),
    })
  : null;
const batteryPlot = mix
  ? mixBatterySvg(mix, {
      id: "generation-battery-chart",
      title: "Battery (stored power)",
      summary: generationMixBatterySummary(mix),
    })
  : null;
const table = mix ? generationMixTable(mix) : null;
const sourceNote = generationMixSourceNote(day.generation);
---

{
  mix === null || svg === null || batteryPlot === null || table === null ? (
    <p class="chart-missing">
      Generation numbers for this day are missing, so there is no chart.
    </p>
  ) : (
    <ChartFigure
      plots={[svg, batteryPlot]}
      tableCaptionId="generation-mix-table-caption"
      tableCaption="Average megawatts by fuel for each 30-minute period. Shares are of the primary total, which excludes battery."
      headers={table.headers}
      rows={table.rows}
      legendLabel="Fuels, top of the stack first, then battery"
      notice={
        mix.incomplete
          ? "Some generation numbers are missing. Where a plant has no number, the chart counts it as 0, and the table marks that time as incomplete."
          : undefined
      }
    >
      <Fragment slot="legend">
        {[...mix.layers].reverse().map((layer) => (
          <li>
            <span
              class="swatch"
              style={`background: ${FUEL_COLOUR[layer.fuel]}`}
              aria-hidden="true"
            />
            {layer.label}
          </li>
        ))}
        <li>
          <span
            class="swatch"
            style={`background: ${BATTERY_COLOUR}`}
            aria-hidden="true"
          />
          {BATTERY_LABEL}
        </li>
      </Fragment>
      <Fragment slot="caption">
        <p>
          Average megawatts for each 30-minute period. Each band is one fuel.
        </p>
      </Fragment>
      <Fragment slot="method">
        <p>
          Hover over the chart to see the numbers for one period. Each band is
          stacked on the bands below it.
        </p>
        <p>
          Source: Electricity Authority generation data, one row per power
          station, grouped by fuel.
        </p>
        {sourceNote ? <p>{sourceNote}</p> : null}
        <p>
          Batteries are not in the stack and not in the primary total. Their
          power is the panel under the stack, and the last column of the table.
        </p>
      </Fragment>
    </ChartFigure>
  )
}

<style>
  .chart-missing {
    margin: 0;
  }

  li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .swatch {
    width: 1rem;
    height: 1rem;
    border-radius: 0.25rem;
    flex: none;
  }
</style>

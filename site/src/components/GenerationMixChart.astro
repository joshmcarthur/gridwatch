---
import * as Plot from "@observablehq/plot";
import type { SiteDay } from "@gridwatch/publisher/site-contract";
import ChartFigure from "./ChartFigure.astro";
import { renderPlot } from "../lib/chart-svg";
import {
  type GenerationMix,
  type MixPoint,
  type StackFuel,
  batteryPointTitle,
  generationMix,
  generationMixBatterySummary,
  generationMixSummary,
  generationMixTable,
  mixPointTitle,
} from "../lib/generation-mix";

interface Props {
  day: SiteDay;
}

const { day } = Astro.props;

/** Fuel colours come from the Landscape tokens in tokens.css (ADR-0015). */
const FUEL_COLOUR: Record<StackFuel, string> = {
  hydro: "var(--color-fuel-hydro)",
  geothermal: "var(--color-fuel-geothermal)",
  wind: "var(--color-fuel-wind)",
  solar: "var(--color-fuel-solar)",
  gas: "var(--color-fuel-gas)",
  coal_gas: "var(--color-fuel-coal-gas)",
  other: "var(--color-fuel-other)",
  unmapped: "var(--color-fuel-unmapped)",
};

const mix = generationMix(day);
const BATTERY_COLOUR = "var(--color-fuel-battery)";
const BATTERY_LABEL = "Battery (stored power)";

function timeAxis(data: GenerationMix) {
  const labelAt = new Map(
    data.ticks.map((tick) => [tick.at.getTime(), tick.label]),
  );
  return {
    label: "Hour (New Zealand time)",
    domain: [data.points[0]?.start, data.points.at(-1)?.start],
    nice: false as const,
    ticks: data.ticks.map((tick) => tick.at),
    tickFormat: (value: Date) => labelAt.get(value.getTime()) ?? "",
  };
}

function hoverRules(data: GenerationMix, titleOf: (point: MixPoint) => string) {
  return Plot.ruleX(
    data.points.map((point) => ({
      start: point.start,
      title: titleOf(point),
    })),
    { x: "start", stroke: "transparent", strokeWidth: 8, title: "title" },
  );
}

function chartSvg(data: GenerationMix): string {
  return renderPlot(
    {
      x: timeAxis(data),
      y: { label: "Average megawatts (MW)", grid: true },
      color: {
        domain: data.layers.map((layer) => layer.fuel),
        range: data.layers.map((layer) => FUEL_COLOUR[layer.fuel]),
      },
      marks: [
        Plot.areaY(data.areas, {
          x: "start",
          y1: "base",
          y2: "top",
          fill: "fuel",
          stroke: "var(--color-card)",
          strokeWidth: 1,
        }),
        hoverRules(data, (point) => mixPointTitle(point, data.layers)),
      ],
    },
    {
      id: "generation-mix-chart",
      title: "Generation mix by fuel",
      summary: generationMixSummary(data),
    },
  );
}

function batterySvg(data: GenerationMix): string {
  return renderPlot(
    {
      height: 120,
      x: timeAxis(data),
      y: { label: "Battery (MW)", grid: true },
      marks: [
        Plot.areaY(data.battery, {
          x: "start",
          y: "megawatts",
          fill: BATTERY_COLOUR,
          stroke: "var(--color-card)",
          strokeWidth: 1,
        }),
        hoverRules(data, batteryPointTitle),
      ],
    },
    {
      id: "generation-battery-chart",
      title: "Battery (stored power)",
      summary: generationMixBatterySummary(data),
    },
  );
}

const svg = mix ? chartSvg(mix) : null;
const batteryPlot = mix ? batterySvg(mix) : null;
const table = mix ? generationMixTable(mix) : null;
---

{
  mix === null || svg === null || batteryPlot === null || table === null ? (
    <p class="chart-missing">
      Generation numbers for this day are missing, so there is no chart.
    </p>
  ) : (
    <ChartFigure
      plots={[svg, batteryPlot]}
      tableCaptionId="generation-mix-table-caption"
      tableCaption="Average megawatts by fuel for each 30-minute period. Shares are of the primary total, which excludes battery."
      headers={table.headers}
      rows={table.rows}
      legendLabel="Fuels, top of the stack first, then battery"
      notice={
        mix.incomplete
          ? "Some generation numbers are missing. Where a plant has no number, the chart counts it as 0, and the table marks that time as incomplete."
          : undefined
      }
    >
      <Fragment slot="legend">
        {[...mix.layers].reverse().map((layer) => (
          <li>
            <span
              class="swatch"
              style={`background: ${FUEL_COLOUR[layer.fuel]}`}
              aria-hidden="true"
            />
            {layer.label}
          </li>
        ))}
        <li>
          <span
            class="swatch"
            style={`background: ${BATTERY_COLOUR}`}
            aria-hidden="true"
          />
          {BATTERY_LABEL}
        </li>
      </Fragment>
      <Fragment slot="caption">
        <p>
          Average megawatts (MW) for each 30-minute period. Each band is one
          fuel, stacked on the bands below it. Hover over the chart to see the
          numbers for one period.
        </p>
        <p>
          Source: Electricity Authority generation data, one row per power
          station, grouped by fuel.
        </p>
        <p>
          Batteries are not in the stack and not in the primary total. Their
          power is the panel under the stack, and the last column of the table.
        </p>
      </Fragment>
    </ChartFigure>
  )
}

<style>
  .chart-missing {
    margin: 0;
  }

  li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .swatch {
    width: 1rem;
    height: 1rem;
    border-radius: 0.25rem;
    flex: none;
  }
</style>

---
import type { SiteDay } from "@gridwatch/publisher/site-contract";
import ChartFigure from "./ChartFigure.astro";
import { renderSankeySvg, sankeyLegend } from "../lib/sankey-svg";
import {
  energySankey,
  sankeyCaption,
  sankeyMissingCopy,
  sankeySummary,
  sankeyTable,
} from "../lib/sankey";

interface Props {
  day: SiteDay;
}

const { day } = Astro.props;
const chart = energySankey(day);

const svg = chart ? renderSankeySvg(chart) : null;
const table = chart ? sankeyTable(chart) : null;
const legend = chart ? sankeyLegend(chart) : [];
---

{
  chart === null || svg === null || table === null ? (
    <p class="chart-missing">{sankeyMissingCopy()}</p>
  ) : (
    <ChartFigure
      plots={[svg]}
      tableCaptionId="energy-sankey-table-caption"
      tableCaption="Daily energy balance by island, in megawatt-hours. Load is an estimate, not a meter reading. The residual is the leftover, and it can be negative."
      headers={table.headers}
      rows={table.rows}
      legendLabel="Bands in the energy balance"
      notice={
        chart.state === "incomplete"
          ? "Some numbers behind this balance are incomplete. Missing terms stay blank, not zero, so the leftover band may be wrong."
          : undefined
      }
    >
      <Fragment slot="legend">
        {legend.map((item) => (
          <li>
            <span
              class="swatch"
              style={`background: ${item.colour}`}
              aria-hidden="true"
            />
            {item.label}
          </li>
        ))}
      </Fragment>
      <Fragment slot="caption">
        <p>
          {sankeyCaption(chart)}
        </p>
      </Fragment>
      <Fragment slot="method">
        <p>
          Megawatt-hours for the day. Hover a band for the number. The chart
          balances each island's generation against its estimated load. It
          does not trace a path from a station to a house.
        </p>
        <p>
          Load is an estimate from Transpower's real-time dispatch, not a meter
          reading. Transpower is the system operator, the company that runs the
          grid. The residual is generation plus transfer minus load, and it gets
          its own band whenever it is not zero.
        </p>
        <p>{sankeySummary(chart)}</p>
      </Fragment>
    </ChartFigure>
  )
}

<style>
  .chart-missing {
    margin: 0;
  }

  li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .swatch {
    width: 1rem;
    height: 1rem;
    border-radius: 0.25rem;
    flex: none;
  }
</style>

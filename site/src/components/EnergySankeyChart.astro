---
import type { SiteDay } from "@gridwatch/publisher/site-contract";
import ChartFigure from "./ChartFigure.astro";
import { renderSankeySvg, sankeyLegend } from "../lib/sankey-svg";
import {
  energySankey,
  sankeyMissingCopy,
  sankeySummary,
  sankeyTable,
} from "../lib/sankey";

interface Props {
  day: SiteDay;
}

const { day } = Astro.props;
const chart = energySankey(day);

const svg = chart ? renderSankeySvg(chart) : null;
const table = chart ? sankeyTable(chart) : null;
const legend = chart ? sankeyLegend(chart) : [];
---

{
  chart === null || svg === null || table === null ? (
    <p class="chart-missing">{sankeyMissingCopy()}</p>
  ) : (
    <ChartFigure
      plots={[svg]}
      tableCaptionId="energy-sankey-table-caption"
      tableCaption="Daily energy balance by island, in megawatt-hours. Load is modelled. Residual keeps its sign."
      headers={table.headers}
      rows={table.rows}
      legendLabel="Bands in the energy balance"
      notice={
        chart.state === "incomplete"
          ? "Some numbers behind this balance are incomplete. The residual still uses the gold formula, and missing terms stay blank rather than zero."
          : undefined
      }
    >
      <Fragment slot="legend">
        {legend.map((item) => (
          <li>
            <span
              class="swatch"
              style={`background: ${item.colour}`}
              aria-hidden="true"
            />
            {item.label}
          </li>
        ))}
      </Fragment>
      <Fragment slot="caption">
        <p>
          Energy for the whole day, from fuel to each island, across the cable,
          then to modelled load.
        </p>
      </Fragment>
      <Fragment slot="method">
        <p>
          Megawatt-hours for the day. Hover a band for the number. The
          New Zealand grid is meshed: electricity does not travel on one path
          from a station to a house. This chart is a set of regional balances,
          not generator-to-consumer flows.
        </p>
        <p>
          Load is modelled from the system operator's real-time dispatch. A
          household meter is a different number. The residual is its own band
          whenever it is not zero. It includes generation that the Generation_MD
          files omit; that list is in the sources notes, section 3.5.
        </p>
        <p>{sankeySummary(chart)}</p>
      </Fragment>
    </ChartFigure>
  )
}

<style>
  .chart-missing {
    margin: 0;
  }

  li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .swatch {
    width: 1rem;
    height: 1rem;
    border-radius: 0.25rem;
    flex: none;
  }
</style>

---
import type { SiteDay } from "@gridwatch/publisher/site-contract";
import ChartFigure from "./ChartFigure.astro";
import { renderSankeySvg } from "../lib/sankey-svg";
import {
  type EnergySankey,
  energySankey,
  sankeyMissingCopy,
  sankeySummary,
  sankeyTable,
} from "../lib/sankey";

interface Props {
  day: SiteDay;
}

const { day } = Astro.props;
const chart = energySankey(day);

const LEGEND: Array<{ label: string; colour: string }> = [
  { label: "Hydro", colour: "var(--color-fuel-hydro)" },
  { label: "Geothermal", colour: "var(--color-fuel-geothermal)" },
  { label: "Wind", colour: "var(--color-fuel-wind)" },
  { label: "Solar", colour: "var(--color-fuel-solar)" },
  { label: "Gas", colour: "var(--color-fuel-gas)" },
  { label: "Coal/gas", colour: "var(--color-fuel-coal-gas)" },
  { label: "North Island", colour: "var(--color-island-north)" },
  { label: "South Island", colour: "var(--color-island-south)" },
  { label: "Inter-island cable", colour: "var(--color-brand)" },
  { label: "Modelled load", colour: "var(--color-ink-muted)" },
  { label: "Residual", colour: "var(--color-caution)" },
  { label: "Cable losses", colour: "var(--color-rule)" },
  { label: "Battery (stored power)", colour: "var(--color-fuel-battery)" },
];

function presentLegend(data: EnergySankey): typeof LEGEND {
  const kinds = new Set(data.nodes.map((node) => node.kind));
  const fuels = new Set(
    data.nodes
      .filter((node) => node.kind === "fuel" || node.kind === "battery")
      .map((node) => node.label),
  );
  return LEGEND.filter((item) => {
    if (item.label === "Battery (stored power)") return kinds.has("battery");
    if (item.label === "Residual") return kinds.has("residual");
    if (item.label === "Cable losses") return kinds.has("losses");
    if (item.label === "Inter-island cable") return kinds.has("hvdc");
    if (item.label === "Modelled load") return kinds.has("load");
    if (item.label === "North Island" || item.label === "South Island")
      return kinds.has("island");
    return fuels.has(item.label);
  });
}

const svg = chart ? renderSankeySvg(chart) : null;
const table = chart ? sankeyTable(chart) : null;
const legend = chart ? presentLegend(chart) : [];
---

{
  chart === null || svg === null || table === null ? (
    <p class="chart-missing">{sankeyMissingCopy()}</p>
  ) : (
    <ChartFigure
      plots={[svg]}
      tableCaptionId="energy-sankey-table-caption"
      tableCaption="Daily energy balance by island, in megawatt-hours. Load is modelled. Residual keeps its sign."
      headers={table.headers}
      rows={table.rows}
      legendLabel="Bands in the energy balance"
      notice={
        chart.state === "incomplete"
          ? "Some numbers behind this balance are incomplete. The residual still uses the gold formula, and missing terms stay blank rather than zero."
          : undefined
      }
    >
      <Fragment slot="legend">
        {legend.map((item) => (
          <li>
            <span
              class="swatch"
              style={`background: ${item.colour}`}
              aria-hidden="true"
            />
            {item.label}
          </li>
        ))}
      </Fragment>
      <Fragment slot="caption">
        <p>
          Megawatt-hours for the whole trading day. Bands run from generation by
          fuel, to each island, across the inter-island cable (the HVDC link),
          then to modelled load. Hover a band for the number.
        </p>
        <p>
          The New Zealand grid is meshed: electricity does not travel on one
          path from a station to a house. This chart is a set of regional
          balances, not generator-to-consumer flows.
        </p>
        <p>
          Load is modelled from the system operator's real-time dispatch. A
          household meter is a different number. The residual is its own band
          whenever it is not zero. It includes generation that the Generation_MD
          files omit; that list is in the sources notes, section 3.5.
        </p>
        <p>{sankeySummary(chart)}</p>
      </Fragment>
    </ChartFigure>
  )
}

<style>
  .chart-missing {
    margin: 0;
  }

  li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .swatch {
    width: 1rem;
    height: 1rem;
    border-radius: 0.25rem;
    flex: none;
  }
</style>

---
import type { SiteDay } from "@gridwatch/publisher/site-contract";
import ChartFigure from "./ChartFigure.astro";
import {
  type LinePlot,
  type PlotLine,
  renderLinePlot,
} from "../lib/line-plot";
import {
  PRICE_MISSING,
  PRICE_NOTICE,
  type PriceChart,
  type PriceIsland,
  type PriceNodeLine,
  type PlottedSpreadLine,
  priceChart,
  priceChartDaily,
  priceChartSummary,
  priceChartTable,
  priceSpreadSummary,
} from "../lib/price-chart";
import { placeName } from "../lib/price-regions";

interface Props {
  day: SiteDay;
}

const { day } = Astro.props;
const chart = priceChart(day);

/**
 * Island colours from the Landscape tokens (ADR-0015). North Island is Tarn and South Island is
 * amber. North Island has two nodes, so OTA is solid and HAY is dashed, both in Tarn.
 */
function islandColour(island: PriceIsland): string {
  switch (island) {
    case "NI":
      return "var(--color-island-north)";
    case "SI":
      return "var(--color-island-south)";
    default: {
      const _exhaustive: never = island;
      return _exhaustive;
    }
  }
}

/** Spreads use ink, not island colour (ADR-0017). */
function spreadColour(spread: PlottedSpreadLine): string {
  return spread.dashed ? "var(--color-ink-muted)" : "var(--color-ink)";
}

function nodeLine(node: PriceNodeLine): PlotLine {
  return {
    id: node.poc,
    values: node.values,
    colour: islandColour(node.island),
    dashed: node.dashed,
    proxy: node.proxy,
  };
}

function spreadLine(spread: PlottedSpreadLine): PlotLine {
  return {
    id: spread.name,
    values: spread.values,
    colour: spreadColour(spread),
    dashed: spread.dashed,
  };
}

function pricePlot(data: PriceChart): LinePlot {
  return {
    id: "price-chart",
    title: "Wholesale price at three places",
    yLabel: "Wholesale price ($ per megawatt-hour, $/MWh)",
    domain: data.priceDomain,
    lines: data.nodes.map(nodeLine),
    bands: data.bands.map((band) => ({
      start: band.x1,
      end: band.x2,
      title: band.title,
    })),
  };
}

function spreadPlot(data: PriceChart): LinePlot {
  return {
    id: "price-spread-chart",
    title: "Price gap between places",
    yLabel: "Spread ($/MWh), first place minus second",
    domain: data.spreadDomain,
    lines: data.plottedSpreads.map(spreadLine),
    zeroLine: true,
    bands: data.bands.map((band) => ({
      start: band.x1,
      end: band.x2,
      title: band.title,
    })),
  };
}

const table = chart ? priceChartTable(chart) : null;
const plots = chart
  ? [
      renderLinePlot(pricePlot(chart), chart, priceChartSummary(chart)),
      renderLinePlot(spreadPlot(chart), chart, priceSpreadSummary(chart)),
    ]
  : null;
const daily = chart ? priceChartDaily(chart) : [];
const anyProxy = chart?.nodes.some((node) => node.proxy.some(Boolean)) ?? false;
---

{
  chart === null || plots === null || table === null ? (
    <p class="chart-missing">{PRICE_MISSING}</p>
  ) : (
    <ChartFigure
      plots={plots}
      tableCaptionId="wholesale-prices-table-caption"
      tableCaption="Wholesale prices in $/MWh for each 30-minute period. A spread is the first place minus the second, so a positive spread means the first place is more expensive."
      headers={table.headers}
      rows={table.rows}
      legendLabel="Lines in the price and spread charts"
      notice={chart.incomplete ? PRICE_NOTICE : undefined}
    >
      <Fragment slot="legend">
        {chart.nodes.map((node) => (
          <li>
            <span
              class="line-key"
              style={`border-top-color: ${islandColour(node.island)}; border-top-style: ${node.dashed ? "dashed" : "solid"}`}
              aria-hidden="true"
            />
            {node.label}
          </li>
        ))}
        {chart.plottedSpreads.map((spread) => (
          <li>
            <span
              class="line-key"
              style={`border-top-color: ${spreadColour(spread)}; border-top-style: ${spread.dashed ? "dashed" : "solid"}`}
              aria-hidden="true"
            />
            Spread {placeName(spread.from)} minus {placeName(spread.to)}
          </li>
        ))}
        {chart.bands.length > 0 && (
          <li>
            <span class="band-key" aria-hidden="true" />
            Unusual stretch
          </li>
        )}
      </Fragment>
      <Fragment slot="caption">
        <p>
          Average wholesale price over each 30-minute period at three places:
          Ōtāhuhu, Haywards and Benmore. A spread is the price at one place
          minus the price at another, so it shows how far apart they are.
        </p>
      </Fragment>
      <Fragment slot="method">
        <p>
          Each point is the average over the period. A short spike inside a
          period is smoothed out, so the highest price of the day can be above
          the line.
        </p>
        {chart.bands.length > 0 && (
          <p>A shaded band marks a stretch that stood out.</p>
        )}
        <p>
          Where two spread lines have the same values, one sits on top of the
          other.
        </p>
        {anyProxy && <p>An open circle marks a price copied from a nearby place after an outage.</p>}
        {daily.map((line) => (
          <p>{line}</p>
        ))}
        <p>
          Source: Electricity Authority wholesale energy prices at Ōtāhuhu,
          Haywards and Benmore. These are first-published prices. The Authority
          confirms them by 2pm on the next business day, so they can change.
        </p>
      </Fragment>
    </ChartFigure>
  )
}

<style>
  .chart-missing {
    margin: 0;
  }

  li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .line-key {
    width: 1.5rem;
    flex: none;
    border-top-width: 3px;
  }

  .band-key {
    width: 1.5rem;
    height: 0.75rem;
    flex: none;
    background: var(--color-header-muted);
    opacity: 0.55;
  }
</style>
